{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Post",
  "version": "0.1.1",
  "identifier": "dev.openpost.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Post",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "diya PROJECT",
    "homepage": "https://github.com/denimars/open-post",
    "category": "DeveloperTool",
    "shortDescription": "Open source API client",
    "longDescription": "Open Post is a desktop client for testing REST/HTTP APIs. Requests are executed by its Rust backend instead of the webview, so there are no CORS restrictions. It supports a request builder, collections, history and environment variables.",
    "license": "GPL-3.0-only",
    "copyright": "Copyright (c) 2026 diya PROJECT",
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "postInstallScript": "deb/postinst",
        "postRemoveScript": "deb/postrm"
      }
    }
  }
}
